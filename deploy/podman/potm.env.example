# Konfiguration für den Container – wird von setup.sh nach /etc/potm/potm.env kopiert
# (Besitzer root:potm, Rechte 0640). Nach Änderungen: ./deploy/podman/update.sh --no-pull

# Öffentliche Adresse genau wie im Caddyfile (mit https://)
ALLOWED_ORIGINS=https://foto.example.de

# Lokaler Port, auf den Caddy weiterleitet (reverse_proxy 127.0.0.1:<APP_PORT>).
# Wird von setup.sh in die Quadlet-Unit übernommen.
APP_PORT=3000

APP_TIMEZONE=Europe/Berlin
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=25
SESSION_TTL_HOURS=168

# Erstes Admin-Konto (nur beim allerersten Start benötigt, danach entfernen)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-ein-langes-passwort-setzen
