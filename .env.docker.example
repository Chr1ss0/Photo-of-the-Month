# Kopieren nach .env (im Projektordner) und anpassen
DOMAIN=foto.example.de
APP_TIMEZONE=Europe/Berlin
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=25
SESSION_TTL_HOURS=168

# Erstes Admin-Konto (nur beim allerersten Start benötigt, danach entfernen)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-ein-langes-passwort-setzen
