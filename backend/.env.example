# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Zeitzone für Monatswechsel und Deadlines
APP_TIMEZONE=Europe/Berlin

# Speicherort für Datenbank und Bilder (relativ zum backend-Ordner)
DATA_DIR=data

# Sicherheit
# In Produktion hinter HTTPS: true (setzt Secure-Cookies mit __Host- Präfix)
COOKIE_SECURE=false
# Erlaubte Origins für schreibende Requests (kommagetrennt)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Anzahl vertrauenswürdiger Reverse-Proxies (z. B. 1 hinter nginx)
TRUST_PROXY=0
SESSION_TTL_HOURS=168
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=25

# Erstes Admin-Konto (wird beim Start angelegt, falls noch kein Admin existiert)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-unbedingt-aendern

# Challenge-Generator: Wahrscheinlichkeit (0-100) für einen zusätzlichen Twist
CHALLENGE_TWIST_CHANCE=60
